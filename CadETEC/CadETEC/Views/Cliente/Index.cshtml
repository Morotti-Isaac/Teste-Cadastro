@model List<Model.Entity.Cliente>
@{
    ViewBag.Title = "Lista de Clientes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h2 class="text-success mb-0"><i class="bi bi-people-fill"></i> Lista de Clientes
        <span class="badge bg-primary fs-6 align-middle">@Model.Count</span></h2>
    <a class="btn btn-primary" href="@Url.Action("Create", "Cliente")"><i class="bi bi-plus-circle"></i> Novo</a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="card cad-card">
    <div class="card-body">
        <div class="input-group mb-3">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="filtro" class="form-control" placeholder="Pesquisar por nome, CPF, endereço ou telefone..." />
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox display-4"></i>
                <p class="mt-2 mb-0">Nenhum cliente cadastrado.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle" id="tabelaClientes">
                    <thead class="table-primary">
                        <tr>
                            <th>Código</th>
                            <th>Nome</th>
                            <th>CPF</th>
                            <th>Endereço</th>
                            <th>Telefone</th>
                            <th class="text-center">Operações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var objCliente in Model)
                        {
                            <tr>
                                <td>@objCliente.idCliente</td>
                                <td>@objCliente.nome</td>
                                <td>@objCliente.cpfFormatado</td>
                                <td>@objCliente.endereco</td>
                                <td>@objCliente.telefone</td>
                                <td class="text-nowrap text-center">
                                    <a class="btn btn-sm btn-success" title="Consultar" href="@Url.Action("Find", "Cliente", new { id = objCliente.idCliente })"><i class="bi bi-eye"></i></a>
                                    <a class="btn btn-sm btn-info text-white" title="Alterar" href="@Url.Action("Update", "Cliente", new { id = objCliente.idCliente })"><i class="bi bi-pencil-square"></i></a>
                                    <a class="btn btn-sm btn-danger" title="Excluir" href="@Url.Action("Eliminar", "Cliente", new { id = objCliente.idCliente })"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p id="semResultado" class="text-center text-muted d-none">Nenhum cliente encontrado para a pesquisa.</p>
        }
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var filtro = document.getElementById('filtro');
            var tabela = document.getElementById('tabelaClientes');
            if (!filtro || !tabela) return;
            filtro.addEventListener('input', function () {
                var termo = filtro.value.toLowerCase();
                var linhas = tabela.tBodies[0].rows;
                var visiveis = 0;
                for (var i = 0; i < linhas.length; i++) {
                    var mostrar = linhas[i].innerText.toLowerCase().indexOf(termo) !== -1;
                    linhas[i].style.display = mostrar ? '' : 'none';
                    if (mostrar) visiveis++;
                }
                document.getElementById('semResultado').classList.toggle('d-none', visiveis !== 0);
            });
        })();
    </script>
}
