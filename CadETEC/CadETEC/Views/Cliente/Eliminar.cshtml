@model Model.Entity.Cliente
@{
    ViewBag.Title = "Excluir Cliente";
}

<h2 class="text-danger mb-3"><i class="bi bi-trash"></i> Excluir Cliente</h2>

<div class="alert alert-warning">Tem certeza de que deseja excluir este cliente? Esta ação não pode ser desfeita.</div>

<div class="card cad-card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.idCliente)</dt>
            <dd class="col-sm-9">@Model.idCliente</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.nome)</dt>
            <dd class="col-sm-9">@Model.nome</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.cpf)</dt>
            <dd class="col-sm-9">@Model.cpfFormatado</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.endereco)</dt>
            <dd class="col-sm-9">@Model.endereco</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.telefone)</dt>
            <dd class="col-sm-9">@Model.telefone</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent">
        @using (Html.BeginForm("Eliminar", "Cliente", new { id = Model.idCliente }, FormMethod.Post, new { @class = "d-flex gap-2" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sim, excluir</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Cliente")">Cancelar</a>
        }
    </div>
</div>
